{
  "name": "fanteam-season-lab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "test": "npm run test:frontend && npm run test:worker",
    "test:frontend": "node --test test/frontend/*.test.mjs",
    "test:worker": "node worker/test/smoke.mjs && node --test worker/test/futbolfantasy.test.mjs worker/test/futbolfantasy-entry.test.mjs",
    "test:e2e": "playwright test",
    "test:production": "playwright test --config=playwright.production.config.mjs",
    "test:e2e:install": "playwright install chromium",
    "audit:css": "node scripts/audit-css.mjs --coverage",
    "lint": "npx --yes eslint@9.32.0 \"src/**/*.js\" \"worker/src/**/*.js\" \"scripts/**/*.mjs\"",
    "lint:fix": "npm run lint -- --fix",
    "format": "npx --yes prettier@3.6.2 --write \"**/*.{js,mjs,json,md,yml,yaml,css,html}\"",
    "format:check": "npx --yes prettier@3.6.2 --check \"**/*.{js,mjs,json,md,yml,yaml,css,html}\""
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "jsdom": "29.1.1"
  }
}
